# Spotify app credentials: https://developer.spotify.com/dashboard
# Create an app, add the redirect URI below to its settings, and (2026 rules) add
# each user who will log in under "User Management". The app owner needs Spotify Premium.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback

# YouTube playlists (public or unlisted, no login): an API key from
# https://console.cloud.google.com with "YouTube Data API v3" enabled.
YOUTUBE_API_KEY=
